# Copy to .env in this backend directory. Never put these values in frontend files.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Ordered alternate text models, maximum 19 (20 including the primary).
GEMINI_FALLBACK_MODELS=["gemini-2.5-flash","gemini-2.5-flash-lite","gemini-3.1-flash-lite","gemini-3.5-flash"]
GEMINI_MODEL_TIMEOUT_SECONDS=18
GEMINI_REQUEST_BUDGET_SECONDS=60
GEMINI_MODEL_COOLDOWN_SECONDS=45
MONGODB_URI=
MONGODB_DATABASE=ai_hr_interview
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
