# Common backend configuration (keep real credentials in .env only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=["gemini-2.5-flash","gemini-2.5-flash-lite"]
GEMINI_REQUEST_BUDGET_SECONDS=60
GEMINI_MODEL_TIMEOUT_SECONDS=18
# sqlite: durable local reports, no database service needed.
# mongodb: use your configured MongoDB URI; never silently fall back.
STORAGE_BACKEND=sqlite
MONGODB_URI=mongodb://localhost:27017/
DATABASE_NAME=ai_hr_interview
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]
